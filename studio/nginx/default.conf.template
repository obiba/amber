server {
    listen       80;
    server_name  localhost;

    #access_log  /var/log/nginx/host.access.log  main;

    location / {
        root   /usr/share/nginx/html;
        index  index.html index.htm;
        try_files $uri /index.html;

        # Rewrite hardcoded asset paths to the runtime public path
        sub_filter './assets/' '${PATH_PREFIX}assets/';
        sub_filter './icons/' '${PATH_PREFIX}icons/';
        sub_filter './favicon.ico' '${PATH_PREFIX}favicon.ico';
        sub_filter './env.js' '${PATH_PREFIX}env.js';
        sub_filter_once off;
        sub_filter_types application/javascript text/css;
    }

    # runtime config and branding files: always revalidated, so that modifications apply to new app instances
    location ~ ^/(settings\.json|env\.js|favicon\.(ico|svg)|apple-touch-icon\.png|manifest\.json|icons/[^/]+)$ {
        root   /usr/share/nginx/html;
        add_header Cache-Control "no-cache";
    }

    #error_page  404              /404.html;

    # redirect server error pages to the static page /50x.html
    #
    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }

    location = /robots.txt  {
        access_log off;
        log_not_found off;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
